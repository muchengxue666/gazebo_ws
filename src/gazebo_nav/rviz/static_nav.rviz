Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz/Grid
      Cell Size: 0.5
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: map
    - Alpha: 0.8
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Static Map
      Topic: /map
      Unreliable: false
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Class: rviz/LaserScan
      Enabled: true
      Name: LaserScan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Value: true
    - Class: rviz/PoseArray
      Color: 0; 255; 0
      Enabled: true
      Name: AMCL Particles
      Topic: /particlecloud
      Unreliable: false
    - Alpha: 0.65
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic: /move_base/global_costmap/costmap
      Unreliable: false
    - Alpha: 0.75
      Class: rviz/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Local Costmap
      Topic: /move_base/local_costmap/costmap
      Unreliable: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.03
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: Global Plan
      Offset: 0; 0; 0
      Pose Color: 255; 85; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.1
      Topic: /move_base/GlobalPlanner/plan
      Unreliable: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 170; 0
      Enabled: false
      Head Diameter: 0.03
      Head Length: 0.03
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: TEB Local Plan
      Offset: 0; 0; 0
      Pose Color: 255; 85; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.1
      Topic: /move_base/TebLocalPlannerROS/local_plan
      Unreliable: false
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 85; 170; 255
      Enabled: true
      Head Diameter: 0.03
      Head Length: 0.03
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: DWA Local Plan
      Offset: 0; 0; 0
      Pose Color: 85; 170; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.01
      Shaft Length: 0.1
      Topic: /move_base/DWAPlannerROS/local_plan
      Unreliable: false
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
      Theta std deviation: 0.261799
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Transformation:
    Current:
      Class: rviz/TF
  Views:
    Current:
      Angle: 0
      Class: rviz/TopDownOrtho
      Name: TopDownOrtho
      Near Clip Distance: 0.01
      Scale: 80
      Target Frame: map
      X: 0
      Y: -1.5
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 40
